// bubbler profile: claude-code-strict
//
// `claude-code` with the egress filtered by name. The sandbox reaches
// the hosts listed below over HTTPS and nothing else: bubbler runs a
// CONNECT proxy in the sandbox's own network namespace, points the
// tool at it (`HTTPS_PROXY` and the six other variables the `network`
// node sets), and the nftables ruleset accepts that one process and no
// other. The application resolves nothing itself — DNS is the proxy's
// too — so a client of its own that ignores the proxy variables fails
// at the name lookup rather than at the connection. The proxy asks the
// resolver bubbler names on its argv, with a DNS client of its own: it
// shares the sandbox's mount namespace, where NSS would let the
// application answer for every name it lists.
//
// The list is every host Anthropic documents as a Claude Code network
// access requirement, minus `formulae.brew.sh` (Homebrew, which is not
// how anything here is installed). The comment above each group says
// what it carries, so pruning is a matter of deleting the group you do
// not want: no connectors, no Artifacts, no telemetry, no documentation
// lookups. `/login` works — the URL is opened in a browser on the host,
// and the code you paste back is exchanged with `claude.ai` and
// `platform.claude.com`.
//
// It is documentation, not measurement: nobody has yet run the tool
// through this profile end to end, so a feature that reaches a host the
// table does not name will fail here first. The failure is the proxy
// refusing a name, and the line naming it goes to bubbler's stderr —
// your terminal for a run started from one, and `bubbler log <name>`
// for a run with no terminal, which is how a desktop entry or a shim
// starts one. The fix is one more `allow-host`:
//
//   allow-host "github.com"
//   allow-host "objects.githubusercontent.com"
//
// The two `datadoghq` names are one Datadog site's, `us5`; a tenant on
// another site sends its telemetry somewhere else and would need those
// names instead. To send none at all, delete that group and add
// `env DISABLE_TELEMETRY="1"` and
// `env CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"`.
//
// What is filtered away: `WebFetch` of any URL off the list, an MCP
// server that reaches a service of its own, and `git`, `gh` or `curl`
// against a forge or registry not named here. Two of the names are not
// destination bounds at all — `storage.googleapis.com` and
// `raw.githubusercontent.com` are shared hosting anyone may publish
// under, so bytes can leave through either; the group comments say so,
// and each group is there to be deleted where the feature is not used.
//
// A name is reached on 443 unless the line says `port=<n>`, `*.` at the
// front matches exactly one label, and a wildcard directly under a
// top-level domain is a lint note. Nothing here is plain HTTP: the
// proxy tunnels CONNECT and forwards no other method.
//
// Runtime: `passt` and `nftables` as any filtered network needs, plus a
// delegated cgroup2 subtree for the proxy's own cgroup — a systemd user
// session has one, and without it the run is refused rather than
// started unfiltered. Everything else is `claude-code`'s: read that
// profile's header for the native vs npm install layouts, the login,
// and what is deliberately absent.
lint-allow "outbound-deny" reason="the deny is the point of this profile: egress is filtered by name, through the proxy, rather than by address"
network {
    outbound "deny"
    // the API, the sign-in pages, and the OAuth exchange a login code goes
    // through; the API also answers WebFetch's domain safety check, and
    // claude.com is a target WebFetch is pre-approved for
    allow-host "api.anthropic.com"
    allow-host "claude.ai"
    allow-host "claude.com"
    allow-host "platform.claude.com"
    // claude.ai connectors (ENABLE_CLAUDEAI_MCP_SERVERS=false drops this)
    allow-host "mcp-proxy.anthropic.com"
    // releases and version checks, plugin executables, plugin metadata, and
    // the npm packages an `npx`-launched MCP server installs. The Google
    // storage host is shared hosting anyone may publish to, so listing it
    // names a host rather than a party: anything in the sandbox that reaches
    // it can put bytes in a bucket of its own. Drop that line if no plugin
    // here needs its metadata.
    allow-host "downloads.claude.ai"
    allow-host "storage.googleapis.com"
    allow-host "registry.npmjs.org"
    // Claude in Chrome, and Artifacts (CLAUDE_CODE_DISABLE_ARTIFACT=1
    // drops the second)
    allow-host "bridge.claudeusercontent.com"
    allow-host "*.frame.claudeusercontent.com"
    // the changelog `/release-notes` reads. Shared hosting as well — every
    // public repository on GitHub is under this one name — so it is a way
    // out as much as a source; drop it if the changelog can go unread.
    allow-host "raw.githubusercontent.com"
    // telemetry and error reports, on Datadog's us5 site
    allow-host "http-intake.logs.us5.datadoghq.com"
    allow-host "browser-intake-us5-datadoghq.com"
    // the documentation the tool looks things up in
    allow-host "code.claude.com"
}
userns "disable"
env DISABLE_AUTOUPDATER="1"
home-share {
    ".local/bin/claude" mode=ro optional=#true
    ".local/share/claude" mode=ro optional=#true
}
command "claude"

#!/usr/bin/env bash
set -euo pipefail

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE CDPATH

release="$(cd -- "$(dirname "$0")" >/dev/null && pwd -P)/release"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

failures=0
check() {
    if ! "$@"; then
        echo "FAIL: $*" >&2
        failures=$((failures + 1))
    fi
}

cat >"$work/cargo-stub" <<'EOF'
#!/bin/sh
echo "updated by stub" >>Cargo.lock
EOF
cat >"$work/makepkg-stub" <<'EOF'
#!/bin/sh
echo "srcinfo for $(sed -n 's/^pkgver=//p' PKGBUILD)"
EOF
chmod +x "$work/cargo-stub" "$work/makepkg-stub"
export RELEASE_CARGO="$work/cargo-stub" RELEASE_MAKEPKG="$work/makepkg-stub"

new_repo() {
    local dir="$work/$1" branch="$2"
    mkdir -p "$dir/fuzz" "$dir/aur/bubbler"
    cd "$dir"
    git init -q -b "$branch"
    git config user.name tester
    git config user.email tester@example.invalid
    git init -q --bare "$work/$1.origin"
    git remote add origin "$work/$1.origin"
    cat >Cargo.toml <<'EOF'
[workspace.package]
version = "1.0.0"
edition = "2024"
rust-version = "1.0.0"

[workspace.dependencies]
bubbler-core = { path = "crates/bubbler-core", version = "1.0.0" }
bubbler-init = { path = "crates/bubbler-init", version = "1.0.0" }
bubbler-net-proxy = { path = "crates/bubbler-net-proxy", version = "1.0.0" }
kdl = "1.0.0"
EOF
    echo lock >Cargo.lock
    echo lock >fuzz/Cargo.lock
    printf '# Changelog\n\n## 9.9.9\n\n- thing\n' >CHANGELOG.md
    cat >aur/bubbler/PKGBUILD <<'EOF'
# Maintainer: Repo Line
pkgbase=bubbler
pkgver=1.0.0
pkgrel=2
# git rev-parse v1.0.0 (the tag object, not the commit it points to)
_tag=0000000000000000000000000000000000000000
EOF
    echo install >aur/bubbler/bubbler.install
    echo old >aur/bubbler/.SRCINFO
    git add -A
    git commit -q -m init
}

state() {
    git status --porcelain
    git tag -l
    git rev-parse HEAD
}

refuses() {
    local before err
    before="$(state)"
    if err="$("$release" "$@" 2>&1 >/dev/null)"; then
        return 1
    fi
    case "$err" in
        "release: "*) ;;
        *) return 1 ;;
    esac
    [ "$(state)" = "$before" ]
}

new_aurs() {
    mkdir -p "$1"
    git -C "$1" init -q
    printf '# Maintainer: Real Maintainer\nold\n' >"$1/PKGBUILD"
    git -C "$1" add PKGBUILD
    git -C "$1" -c user.name=t -c user.email=t@example.invalid commit -q -m first
}

new_repo ok feat/x
check refuses 9.9
check refuses 9.9.9-rc1
check refuses
check refuses --tag
check refuses --tag 9.9.9
printf 'x' >stray
check refuses 9.9.9
rm stray

git checkout -q -b other
sed -i 's/^## 9.9.9/## 9.9.8/' CHANGELOG.md
git commit -qam changelog
check refuses 9.9.9
sed -i 's/^## 9.9.8/## 9.9.9/' CHANGELOG.md
git commit -qam changelog

git checkout -q --detach
check refuses 9.9.9
git checkout -q other

RELEASE_CARGO=false check refuses 9.9.9

"$release" 9.9.9 >/dev/null
check test "$(git log -1 --format=%s)" = "chore: release v9.9.9"
check test "$(git log -1 --format=%B | grep -c .)" = 1
check test "$(git show --name-only --format= HEAD | sort | tr '\n' ' ')" = "Cargo.lock Cargo.toml fuzz/Cargo.lock "
check test "$(git diff HEAD~1 HEAD -- Cargo.toml | grep -c '^+[^+]')" = 4
check grep -q '^kdl = "1.0.0"' Cargo.toml
check grep -q '^rust-version = "1.0.0"' Cargo.toml
check grep -q '^version = "9.9.9"' Cargo.toml
check test "$(grep -c 'version = "9.9.9"' Cargo.toml)" = 4
check test -z "$(git status --porcelain)"
check refuses 9.9.9

check refuses --tag 9.9.8
printf 'x' >stray
check refuses --tag 9.9.9
rm stray
git tag v9.9.9-other
RELEASE_MAKEPKG=false check refuses --tag 9.9.9
RELEASE_MAKEPKG=no-such-makepkg check refuses --tag 9.9.9
before_head="$(git rev-parse HEAD)"
"$release" --tag 9.9.9 >/dev/null
check test "$(git cat-file -t v9.9.9)" = tag
tag_object="$(git rev-parse v9.9.9)"
check grep -qx "_tag=$tag_object" aur/bubbler/PKGBUILD
check grep -qx 'pkgver=9.9.9' aur/bubbler/PKGBUILD
check grep -qx 'pkgrel=1' aur/bubbler/PKGBUILD
check grep -q '^# git rev-parse v9.9.9 ' aur/bubbler/PKGBUILD
check grep -qx 'srcinfo for 9.9.9' aur/bubbler/.SRCINFO
check test "$(git log -1 --format=%s)" = "chore: the AUR package builds 9.9.9"
check test "$(git log -1 --format=%B | grep -c .)" = 1
check test "$(git rev-parse HEAD~1)" = "$before_head"
check test -z "$(git status --porcelain)"
check refuses --tag 9.9.9
check test -z "$(git --git-dir="$work/ok.origin" for-each-ref)"

new_repo withaurs feat/x
git checkout -q -b other
"$release" 9.9.9 >/dev/null
aurs="$work/aurs"
new_aurs "$aurs"
check refuses --tag 9.9.9 "$work/not-a-directory"
mkdir "$work/plain"
check refuses --tag 9.9.9 "$work/plain"
mkdir "$work/nogit"
echo '# Maintainer: X' >"$work/nogit/PKGBUILD"
check refuses --tag 9.9.9 "$work/nogit"
check refuses --tag 9.9.9 "$work"
check refuses --tag 9.9.9 "$work/withaurs/aur/bubbler"
new_aurs "$work/empty"
: >"$work/empty/PKGBUILD"
check refuses --tag 9.9.9 "$work/empty"
new_aurs "$work/nomaint"
echo 'pkgbase=bubbler' >"$work/nomaint/PKGBUILD"
check refuses --tag 9.9.9 "$work/nomaint"
new_aurs "$work/dirsrcinfo"
mkdir "$work/dirsrcinfo/.SRCINFO"
check refuses --tag 9.9.9 "$work/dirsrcinfo"
cd "$work/withaurs"
mkdir sub
cd sub
out="$("$release" --tag 9.9.9 ../../aurs)"
cd ..
check test "$(head -1 "$aurs/PKGBUILD")" = "# Maintainer: Real Maintainer"
check grep -qx 'pkgver=9.9.9' "$aurs/PKGBUILD"
check grep -qx 'pkgrel=1' "$aurs/PKGBUILD"
check grep -qx "_tag=$(git rev-parse v9.9.9)" "$aurs/PKGBUILD"
check test -f "$aurs/bubbler.install"
check grep -qx 'srcinfo for 9.9.9' "$aurs/.SRCINFO"
check test "$(git -C "$aurs" rev-list --count HEAD)" = 1
check grep -qF "git -C $aurs commit -am \"Update to 9.9.9\"" <<<"$out"
check test -z "$(git --git-dir="$work/withaurs.origin" for-each-ref)"

new_repo trunk master
check refuses 9.9.9

new_repo cargofail feat/x
git checkout -q -b other
RELEASE_CARGO=false check refuses 9.9.9
check test -z "$(git status --porcelain)"

new_repo dependrift feat/x
git checkout -q -b other
sed -i 's/^bubbler-init = .*/bubbler-init = "1.0.0"/' Cargo.toml
git commit -qam drift
check refuses 9.9.9
check grep -q '^version = "1.0.0"' Cargo.toml

new_repo pkgdrift feat/x
git checkout -q -b other
"$release" 9.9.9 >/dev/null
sed -i '/^# git rev-parse/d' aur/bubbler/PKGBUILD
git commit -qam drift
check refuses --tag 9.9.9
check test -z "$(git tag -l)"

new_repo makepkgfail feat/x
git checkout -q -b other
"$release" 9.9.9 >/dev/null
RELEASE_MAKEPKG=false check refuses --tag 9.9.9
check grep -qx 'pkgver=1.0.0' aur/bubbler/PKGBUILD

new_repo bumphook feat/x
git checkout -q -b other
printf '#!/bin/sh\nexit 1\n' >.git/hooks/pre-commit
chmod +x .git/hooks/pre-commit
check refuses 9.9.9

new_repo taghook feat/x
git checkout -q -b other
"$release" 9.9.9 >/dev/null
printf '#!/bin/sh\nexit 1\n' >.git/hooks/pre-commit
chmod +x .git/hooks/pre-commit
check refuses --tag 9.9.9
check grep -qx 'pkgver=1.0.0' aur/bubbler/PKGBUILD
check grep -qx '_tag=0000000000000000000000000000000000000000' aur/bubbler/PKGBUILD

# A commit that was made and then reported as failed: the state a signal
# leaves when it lands between `git commit` and the end of its phase.
mkdir "$work/late-fail"
cat >"$work/late-fail/git" <<EOF
#!/bin/sh
$(command -v git) "\$@" || exit
[ "\$1" != commit ]
EOF
chmod +x "$work/late-fail/git"
new_repo latefail feat/x
git checkout -q -b other
err="$(PATH="$work/late-fail:$PATH" "$release" 9.9.9 2>&1 >/dev/null)" && failures=$((failures + 1))
check test "$(git log -1 --format=%s)" = "chore: release v9.9.9"
check test -z "$(git status --porcelain)"
check test -z "$(grep 'rolled back' <<<"$err")"
err="$(PATH="$work/late-fail:$PATH" "$release" --tag 9.9.9 2>&1 >/dev/null)" && failures=$((failures + 1))
check test "$(git log -1 --format=%s)" = "chore: the AUR package builds 9.9.9"
check test "$(git cat-file -t v9.9.9)" = tag
check test -z "$(git status --porcelain)"
check test -z "$(grep 'rolled back' <<<"$err")"

if [ "$(id -u)" -ne 0 ]; then
    new_repo redo feat/x
    git checkout -q -b other
    "$release" 9.9.9 >/dev/null
    new_aurs "$work/redo-aurs"
    chmod a-w "$work/redo-aurs"
    err="$(LC_ALL=C "$release" --tag 9.9.9 "$work/redo-aurs" 2>&1 >/dev/null)" && failures=$((failures + 1))
    chmod u+w "$work/redo-aurs"
    check grep -q "^release: could not write to " <<<"$err"
    check grep -q "Permission denied" <<<"$err"
    check grep -qF -- "--tag 9.9.9 $work/redo-aurs" <<<"$err"
    check test "$(git cat-file -t v9.9.9)" = tag
    check test "$(git log -1 --format=%s)" = "chore: the AUR package builds 9.9.9"
    check test -z "$(git status --porcelain)"
    check test -z "$(git -C "$work/redo-aurs" status --porcelain)"
    check test "$(ls -A "$work/redo-aurs" | LC_ALL=C sort | tr '\n' ' ')" = ".git PKGBUILD "
    redo_head="$(git rev-parse HEAD)"
    redo_out="$("$release" --tag 9.9.9 "$work/redo-aurs")"
    check test "$(git rev-parse HEAD)" = "$redo_head"
    check grep -qF "git -C $work/redo-aurs commit" <<<"$redo_out"
    check test "$(head -1 "$work/redo-aurs/PKGBUILD")" = "# Maintainer: Real Maintainer"
    check grep -qx "_tag=$(git rev-parse v9.9.9)" "$work/redo-aurs/PKGBUILD"
    check grep -qx 'srcinfo for 9.9.9' "$work/redo-aurs/.SRCINFO"
    check test -f "$work/redo-aurs/bubbler.install"
    check test "$(ls -A "$work/redo-aurs" | LC_ALL=C sort | tr '\n' ' ')" = ".SRCINFO .git PKGBUILD bubbler.install "
fi

new_repo handtag feat/x
git checkout -q -b other
"$release" 9.9.9 >/dev/null
git tag -a v9.9.9 -m x
new_aurs "$work/handtag-aurs"
check refuses --tag 9.9.9 "$work/handtag-aurs"
check test -z "$(git -C "$work/handtag-aurs" status --porcelain)"

if [ "$failures" -ne 0 ]; then
    echo "$failures check(s) failed" >&2
    exit 1
fi
echo "all release checks passed"

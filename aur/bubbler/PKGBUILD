# Maintainer: Han

pkgbase=bubbler
pkgname=(bubbler bubbler-ui)
pkgver=0.23.2
pkgrel=1
pkgdesc='Application sandboxing on top of bubblewrap, with named instances, explicit resource grants, and a profile library'
arch=(x86_64)
url='https://github.com/han-xyz/bubbler'
license=(GPL-3.0-or-later)
depends=('bubblewrap>=0.12.0' passt libseccomp libgcc glibc)
makedepends=(cargo git)
# git rev-parse v0.23.2 (the tag object, not the commit it points to)
_tag=c7ca645a0e5b9c15d5174f4ca689934493c62be4
source=("git+$url.git#tag=$_tag")
sha256sums=(SKIP)

pkgver() {
  cd "$pkgbase"
  git describe | sed 's/^v//'
}

prepare() {
  cd "$pkgbase"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgbase"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd "$pkgbase"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Tests that need a real sandbox skip themselves when the build
  # environment cannot create user namespaces (a clean chroot cannot).
  cargo test --frozen --workspace
}

package_bubbler() {
  pkgdesc='Application sandboxing on top of bubblewrap, with named instances, explicit resource grants, and a profile library'
  optdepends=('xdg-dbus-proxy: dbus, system-bus, portals, notify, mpris and tray grants'
              'nftables: outbound filtering and allow-host inside an isolated network'
              'xdg-desktop-portal: file chooser, screencast and camera portals'
              'pipewire: pipewire and pulseaudio grants (pw-container security context)'
              'pipewire-pulse: pulseaudio grant (a private server per sandbox)'
              'wireplumber: the audio policy this package installs, 0.5.15 or newer'
              'xorg-xwayland: the X server a bare x11 runs inside the sandbox'
              'at-spi2-core: a11y grant'
              'bubbler-ui: terminal editor for instances (bubbler ui)')
  install=bubbler.install

  cd "$pkgbase"
  install -Dm755 target/release/bubbler "$pkgdir/usr/bin/bubbler"
  # The supervisor bound into every sandbox; deliberately not on PATH.
  install -Dm755 target/release/bubbler-init "$pkgdir/usr/lib/bubbler/bubbler-init"
  # The Wayland proxy the launcher runs in front of every sandboxed wayland socket.
  install -Dm755 target/release/bubbler-wl-proxy "$pkgdir/usr/lib/bubbler/bubbler-wl-proxy"
  # The CONNECT proxy the launcher runs beside a sandbox that has `allow-host`.
  install -Dm755 target/release/bubbler-net-proxy "$pkgdir/usr/lib/bubbler/bubbler-net-proxy"

  # Man pages are generated by the binary that was just built.
  install -d "$pkgdir/usr/share/man/man1" "$pkgdir/usr/share/man/man5"
  target/release/bubbler man > "$pkgdir/usr/share/man/man1/bubbler.1"
  target/release/bubbler man --config > "$pkgdir/usr/share/man/man5/bubbler-config.5"
  chmod 644 "$pkgdir/usr/share/man/man1/bubbler.1" "$pkgdir/usr/share/man/man5/bubbler-config.5"

  # The WirePlumber policy both audio grants rely on; inert for every
  # client that is not a bubbler security context. Byte-equal to what
  # `bubbler audio-policy --print` and `--print --script` write.
  install -Dm644 contrib/wireplumber/50-bubbler.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-bubbler.conf"
  install -Dm644 contrib/wireplumber/scripts/bubbler/refuse-links.lua \
    "$pkgdir/usr/share/wireplumber/scripts/bubbler/refuse-links.lua"
}

package_bubbler-ui() {
  pkgdesc='Terminal editor for bubbler sandbox instances'
  depends=(bubbler libseccomp libgcc glibc)

  cd "$pkgbase"
  install -Dm755 target/release/bubbler-ui "$pkgdir/usr/bin/bubbler-ui"
}

# The policy is read when WirePlumber starts, so an installed file
# changes nothing for the session manager already running.
_note() {
  cat <<'NOTE'
bubbler's WirePlumber policy is now under /usr/share/wireplumber. A running
WirePlumber loads it on its next start:
    systemctl --user restart wireplumber
Until then a pipewire or pulseaudio grant reaches every PipeWire node,
and each run says so.
NOTE
}

_changed() {
  cat <<'NOTE'
bubbler's WirePlumber policy changed in 0.24.2: until WirePlumber restarts,
a sandbox with a pipewire grant can record other applications through a link
of its own or a sink it offers, give itself the microphone, or silence host
audio with a filter it offers, and a microphone grant records nothing.
Restart it:
    systemctl --user restart wireplumber
Any copy of the policy outside /usr/share (under ~/.config, ~/.local/share,
/etc or /usr/local/share) is not updated by the package and is the one
WirePlumber uses: write it again with bubbler audio-policy --print and
bubbler audio-policy --print --script, or remove it.
NOTE
}

post_install() {
  _note
}

# 0.23.0 is the first release with the policy, 0.24.2 the last that
# changed it; a later release that changes it adds its own version.
post_upgrade() {
  if (( $(vercmp "$2" 0.23.0) < 0 )); then
    _note
  elif (( $(vercmp "$2" 0.24.2) < 0 )); then
    _changed
  fi
}

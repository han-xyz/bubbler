pkgbase = bubbler
	pkgdesc = Application sandboxing on top of bubblewrap, with named instances, explicit resource grants, and a profile library
	pkgver = 0.23.1
	pkgrel = 1
	url = https://github.com/han-xyz/bubbler
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	depends = bubblewrap>=0.12.0
	depends = passt
	depends = libseccomp
	depends = libgcc
	depends = glibc
	source = git+https://github.com/han-xyz/bubbler.git#tag=fd8ff6b975a6c2120cfbaf20ee24143074095fa0
	sha256sums = SKIP

pkgname = bubbler
	pkgdesc = Application sandboxing on top of bubblewrap, with named instances, explicit resource grants, and a profile library
	install = bubbler.install
	optdepends = xdg-dbus-proxy: dbus, system-bus, portals, notify, mpris and tray grants
	optdepends = nftables: outbound filtering and allow-host inside an isolated network
	optdepends = xdg-desktop-portal: file chooser, screencast and camera portals
	optdepends = pipewire: pipewire and pulseaudio grants (pw-container security context)
	optdepends = pipewire-pulse: pulseaudio grant (a private server per sandbox)
	optdepends = wireplumber: the audio policy this package installs, 0.5.15 or newer
	optdepends = xorg-xwayland: the X server a bare x11 runs inside the sandbox
	optdepends = at-spi2-core: a11y grant
	optdepends = bubbler-ui: terminal editor for instances (bubbler ui)

pkgname = bubbler-ui
	pkgdesc = Terminal editor for bubbler sandbox instances
	depends = bubbler
	depends = libseccomp
	depends = libgcc
	depends = glibc
